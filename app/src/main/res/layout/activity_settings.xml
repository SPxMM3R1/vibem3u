<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:paddingStart="112dp"
    android:paddingTop="54dp"
    android:paddingEnd="112dp"
    android:paddingBottom="54dp">

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/settings_glass_panel"
        android:elevation="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="@color/cyan"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_title"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/settings_close_hint"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/settings_tab_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_general"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/normalize_volume"
                android:nextFocusLeft="@id/tab_updates"
                android:nextFocusRight="@id/tab_playback"
                android:text="@string/settings_tab_general"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_playback"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/invert_channel_keys"
                android:nextFocusLeft="@id/tab_general"
                android:nextFocusRight="@id/tab_source"
                android:text="@string/settings_tab_playback"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_source"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/playlist_url"
                android:nextFocusLeft="@id/tab_playback"
                android:nextFocusRight="@id/tab_interface"
                android:text="@string/settings_tab_source"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_interface"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/interface_info"
                android:nextFocusLeft="@id/tab_source"
                android:nextFocusRight="@id/tab_updates"
                android:text="@string/settings_tab_interface"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tab_updates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/check_updates_button"
                android:nextFocusLeft="@id/tab_interface"
                android:nextFocusRight="@id/tab_general"
                android:text="@string/settings_tab_updates"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/tab_page_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_general_heading"
                        android:textColor="@color/cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/settings_section_card"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/audio_settings_title"
                                    android:textColor="@color/cyan"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <Switch
                                    android:id="@+id/normalize_volume"
                                    android:layout_width="match_parent"
                                    android:layout_height="54dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/settings_section_card"
                                    android:focusable="true"
                                    android:nextFocusUp="@id/tab_general"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:showText="false"
                                    android:text="@string/normalize_volume"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    android:thumbTint="@color/cyan" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="@string/normalize_volume_description"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/settings_section_card"
                                android:orientation="vertical"
                                android:padding="18dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_cache_title"
                                    android:textColor="@color/cyan"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="@string/settings_cache_description"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="210dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/settings_help_card"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="◌"
                                android:textColor="@color/cyan"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/settings_tip_title"
                                android:textColor="@color/cyan"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="@string/settings_tip_description"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_playback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_playback_heading"
                        android:textColor="@color/cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/channel_controls_title"
                            android:textColor="@color/cyan"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/invert_channel_keys"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/settings_section_card"
                            android:focusable="true"
                            android:nextFocusUp="@id/tab_playback"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:showText="false"
                            android:text="@string/invert_channel_keys"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:thumbTint="@color/cyan" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/invert_channel_keys_description"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_source_heading"
                        android:textColor="@color/cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_source_title"
                            android:textColor="@color/cyan"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/settings_source_description"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/playlist_url"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/settings_input"
                            android:hint="@string/playlist_url_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textUri"
                            android:nextFocusUp="@id/tab_source"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textColorHint="#78909C"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/url_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:textColor="@color/red"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_interface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_interface_heading"
                        android:textColor="@color/cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/interface_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/settings_section_card"
                        android:focusable="true"
                        android:nextFocusUp="@id/tab_interface"
                        android:padding="22dp"
                        android:text="@string/settings_interface_description"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_updates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_updates_heading"
                        android:textColor="@color/cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/current_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/settings_updates_description"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/check_updates_button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/focus_button"
                            android:focusable="true"
                            android:includeFontPadding="false"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:nextFocusUp="@id/tab_updates"
                            android:text="@string/check_updates"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:textColor="@color/muted"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="126dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/focus_button"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="194dp"
                android:layout_height="42dp"
                android:background="@drawable/focus_button"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/save_and_play"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="@string/settings_remote_help"
            android:textColor="#90A4AE"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
