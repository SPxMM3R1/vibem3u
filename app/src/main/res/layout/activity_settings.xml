<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones (moderno). 0.5.96: línea «Flotante minimalista» (DISENO.md): «OPCIONES», pestañas
     de texto y hora arriba; columna de 390 dp a la izquierda sobre una sola capa oscura, filas sin
     tarjeta (el foco es negrita con línea fina) y opciones de texto con punto verde.
     Antes: centrado desde 2026-10-03: columna de 560 dp al centro con título y hora
     arriba y pestañas centradas. 0.5.90: colores y tamaños del mockup aprobado (blanco en lo
     elegido y en el foco, cyan solo en interruptores encendidos, Roboto 20/11.5/8.5 sp).
     Generado desde el mockup aprobado; el estilo clásico vive en classic_activity_settings.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_backdrop_center"
    android:clipChildren="false"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">


    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- Título y hora sobre la columna; las pestañas van centradas debajo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/settings_title"
                android:textAllCaps="true"
                android:textColor="#9EFFFFFF"
                android:textSize="7.5sp" />

            <LinearLayout
                android:id="@+id/settings_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
    
                <TextView
                    android:id="@+id/tab_playback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_updates"
                    android:nextFocusRight="@id/tab_general"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_playback"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_general"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_playback"
                    android:nextFocusRight="@id/tab_interface"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_general"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_interface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_general"
                    android:nextFocusRight="@id/tab_reminders"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_interface"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_reminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_interface"
                    android:nextFocusRight="@id/tab_source"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_reminders"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_reminders"
                    android:nextFocusRight="@id/tab_providers"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_source"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_providers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_source"
                    android:nextFocusRight="@id/tab_updates"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_providers"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_providers"
                    android:nextFocusRight="@id/tab_playback"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_updates"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/settings_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#B8FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>


        <ScrollView
            android:id="@+id/settings_content"
            android:layout_width="390dp"
            android:layout_height="0dp"
            android:layout_marginTop="34dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdge="none"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/settings_page_reproduccion" />

                <include layout="@layout/settings_page_video_audio" />

                <include layout="@layout/settings_page_interfaz" />

                <include layout="@layout/settings_page_recordatorios" />

                <include layout="@layout/settings_page_canales" />

                <!-- Proveedores (0.6.02, opción A aprobada): proveedores de señal,
                     Highfly Premium y avanzado; antes iban al final de Canales. -->
                <include layout="@layout/settings_page_proveedores" />

                <include layout="@layout/settings_page_sistema" />
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
