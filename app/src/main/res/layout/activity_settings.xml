<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2050A0D">

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_description"
            android:textColor="@color/muted"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/playlist_url"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="#FF182429"
            android:hint="@string/playlist_url_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:paddingHorizontal="16dp"
            android:selectAllOnFocus="false"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#78909C"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/url_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/channel_controls_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/invert_channel_keys"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="@string/invert_channel_keys"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:thumbTint="@color/cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/invert_channel_keys_description"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/audio_settings_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/normalize_volume"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:text="@string/normalize_volume"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:thumbTint="@color/cyan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/normalize_volume_description"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/focus_button"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/focus_button"
                android:text="@string/save_and_play"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/remote_help"
            android:textColor="#90A4AE"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
