<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones (moderno). 0.5.96: línea «Flotante minimalista» (DISENO.md): «OPCIONES», pestañas
     de texto y hora arriba; columna de 390 dp a la izquierda sobre una sola capa oscura, filas sin
     tarjeta (el foco es negrita con línea fina) y opciones de texto con punto verde.
     Antes: centrado desde 2026-10-03: columna de 560 dp al centro con título y hora
     arriba y pestañas centradas. 0.5.90: colores y tamaños del mockup aprobado (blanco en lo
     elegido y en el foco, cyan solo en interruptores encendidos, Roboto 20/11.5/8.5 sp).
     Generado desde el mockup aprobado; el estilo clásico vive en classic_activity_settings.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_backdrop_center"
    android:clipChildren="false"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">


    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- Título y hora sobre la columna; las pestañas van centradas debajo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/settings_title"
                android:textAllCaps="true"
                android:textColor="#9EFFFFFF"
                android:textSize="7.5sp" />

            <LinearLayout
                android:id="@+id/settings_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
    
    
                <TextView
                    android:id="@+id/tab_playback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_updates"
                    android:nextFocusRight="@id/tab_general"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_playback"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_general"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_playback"
                    android:nextFocusRight="@id/tab_interface"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_general"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_interface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_general"
                    android:nextFocusRight="@id/tab_reminders"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_interface"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_reminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_interface"
                    android:nextFocusRight="@id/tab_source"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_reminders"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_reminders"
                    android:nextFocusRight="@id/tab_providers"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_source"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_providers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_source"
                    android:nextFocusRight="@id/tab_updates"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_providers"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
                <TextView
                    android:id="@+id/tab_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/settings_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:nextFocusLeft="@id/tab_providers"
                    android:nextFocusRight="@id/tab_playback"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="5dp"
                    android:text="@string/settings_tab_updates"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />
    
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/settings_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#B8FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <ScrollView
            android:id="@+id/settings_content"
            android:layout_width="390dp"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdge="none"
            android:overScrollMode="never">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/settings_page_reproduccion" />

                <include layout="@layout/settings_page_video_audio" />

                <include layout="@layout/settings_page_interfaz" />

                <include layout="@layout/settings_page_recordatorios" />

                <include layout="@layout/settings_page_canales" />

                <!-- Proveedores (0.6.02, opción A aprobada): proveedores de señal,
                     Highfly Premium y avanzado; antes iban al final de Canales. -->
                <include layout="@layout/settings_page_proveedores" />

                <include layout="@layout/settings_page_sistema" />
            </FrameLayout>
        </ScrollView>

            <!-- Proveedores, segunda columna (0.6.39, mockup aprobado «Si»): desde Highfly Premium
                 hacia abajo, a la derecha de los proveedores de señal. Solo en esa pestaña. -->
            <ScrollView
                android:id="@+id/providers_side_column"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_marginStart="55dp"
                android:clipToPadding="false"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:visibility="gone">
                <include layout="@layout/settings_page_proveedores_extra" />
            </ScrollView>

            <!-- Información de la señal (0.6.33, mockup aprobado «Exacto así»): columna a la
                 derecha de las opciones de En reproducción, para que la página no tenga scroll.
                 Solo informativa: no recibe foco. -->
            <LinearLayout
                android:id="@+id/settings_side_column"
                android:layout_width="235dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="55dp"
                android:layout_marginTop="70dp"
                android:focusable="false"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/signal_info_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="13dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.2"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/settings_section_signal_info"
                        android:textAllCaps="true"
                        android:textColor="#6BFFFFFF"
                        android:textSize="7sp" />
                    <TextView
                        android:id="@+id/signal_info_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_signal_none"
                        android:textColor="@color/minimal_muted"
                        android:textSize="9.5sp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/signal_info_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_resolution"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_resolution"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_frame_rate"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_frame_rate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_bitrate"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_bitrate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_video_codec"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_video"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_audio_codec"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_codecs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_format"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_format"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <!-- Resolutor y respaldo (0.6.34, mockup aprobado «Aplicalo»). -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_resolver"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_resolver"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/signal_backup_cell"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_signal_backup"
                                    android:textColor="@color/minimal_muted"
                                    android:textSize="8.5sp" />
                                <TextView
                                    android:id="@+id/signal_backup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:textColor="@color/white"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
