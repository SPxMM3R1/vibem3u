<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:paddingStart="@dimen/settings_outer_horizontal"
    android:paddingTop="@dimen/settings_outer_vertical"
    android:paddingEnd="@dimen/settings_outer_horizontal"
    android:paddingBottom="@dimen/settings_outer_vertical">

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/settings_glass_panel"
        android:elevation="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/settings_header_padding_horizontal"
            android:paddingEnd="@dimen/settings_header_padding_horizontal">

            <TextView
                android:layout_width="@dimen/settings_header_icon_width"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="@color/cyan"
                android:textSize="@dimen/settings_header_icon_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/settings_title"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_title_text_size"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_tabs_height"
            android:background="@drawable/settings_tab_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/settings_tabs_padding">

            <TextView
                android:id="@+id/tab_general"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/normalize_volume"
                android:nextFocusLeft="@id/tab_updates"
                android:nextFocusRight="@id/tab_playback"
                android:text="@string/settings_tab_general"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />

            <TextView
                android:id="@+id/tab_playback"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/invert_channel_keys"
                android:nextFocusLeft="@id/tab_general"
                android:nextFocusRight="@id/tab_source"
                android:text="@string/settings_tab_playback"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />

            <TextView
                android:id="@+id/tab_source"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/playlist_url"
                android:nextFocusLeft="@id/tab_playback"
                android:nextFocusRight="@id/tab_resolvers"
                android:text="@string/settings_tab_source"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />

            <TextView
                android:id="@+id/tab_resolvers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/update_resolvers_button"
                android:nextFocusLeft="@id/tab_source"
                android:nextFocusRight="@id/tab_interface"
                android:text="@string/settings_tab_resolvers"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />

            <TextView
                android:id="@+id/tab_interface"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/interface_info"
                android:nextFocusLeft="@id/tab_resolvers"
                android:nextFocusRight="@id/tab_updates"
                android:text="@string/settings_tab_interface"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />

            <TextView
                android:id="@+id/tab_updates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/settings_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/check_updates_button"
                android:nextFocusLeft="@id/tab_interface"
                android:nextFocusRight="@id/tab_general"
                android:text="@string/settings_tab_updates"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_tab_text_size" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:paddingTop="@dimen/settings_content_padding_top"
            android:paddingBottom="@dimen/settings_content_padding_bottom">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/tab_page_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_general_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/settings_section_card"
                                android:orientation="vertical"
                                android:padding="@dimen/settings_card_padding">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/audio_settings_title"
                                    android:textColor="@color/cyan"
                                    android:textSize="@dimen/settings_card_title_text_size"
                                    android:textStyle="bold" />

                                <Switch
                                    android:id="@+id/normalize_volume"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/settings_control_height"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/settings_section_card"
                                    android:focusable="true"
                                    android:nextFocusUp="@id/tab_general"
                                    android:nextFocusDown="@id/save_button"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:showText="false"
                                    android:text="@string/normalize_volume"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/settings_control_text_size"
                                    android:thumbTint="@color/cyan" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="@string/normalize_volume_description"
                                    android:textColor="@color/muted"
                                    android:textSize="@dimen/settings_body_text_size" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/settings_section_card"
                                android:orientation="vertical"
                                android:padding="@dimen/settings_card_padding">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/settings_cache_title"
                                    android:textColor="@color/cyan"
                                    android:textSize="@dimen/settings_card_title_text_size"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="@string/settings_cache_description"
                                    android:textColor="@color/muted"
                                    android:textSize="@dimen/settings_body_text_size" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/settings_help_width"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/settings_help_card"
                            android:orientation="vertical"
                            android:padding="@dimen/settings_help_padding">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="◌"
                                android:textColor="@color/cyan"
                                android:textSize="@dimen/settings_help_icon_text_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/settings_tip_title"
                                android:textColor="@color/cyan"
                                android:textSize="@dimen/settings_help_title_text_size"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="@string/settings_tip_description"
                                android:textColor="@color/muted"
                                android:textSize="@dimen/settings_body_text_size" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_playback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_playback_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/current_channel_playback_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="@dimen/settings_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_current_channel_title"
                            android:textColor="@color/cyan"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/settings_current_channel_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/settings_no_current_channel"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_control_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/settings_current_channel_description"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/settings_quality_title"
                            android:textColor="@color/cyan"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/settings_quality_options"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/settings_quality_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/settings_quality_no_options"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/settings_subtitles_title"
                            android:textColor="@color/cyan"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/settings_subtitles_switch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/settings_control_height"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/settings_section_card"
                            android:focusable="true"
                            android:nextFocusDown="@id/invert_channel_keys"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:showText="false"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_control_text_size"
                            android:thumbTint="@color/cyan"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/settings_subtitles_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/subtitles_waiting_for_text"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="@dimen/settings_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/channel_controls_title"
                            android:textColor="@color/cyan"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/invert_channel_keys"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/settings_control_height"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/settings_section_card"
                            android:focusable="true"
                            android:nextFocusUp="@id/tab_playback"
                            android:nextFocusDown="@id/save_button"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:showText="false"
                            android:text="@string/invert_channel_keys"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_control_text_size"
                            android:thumbTint="@color/cyan" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/invert_channel_keys_description"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_source_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="@dimen/settings_card_padding">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_source_title"
                            android:textColor="@color/cyan"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/settings_source_description"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />

                        <EditText
                            android:id="@+id/playlist_url"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/settings_control_height"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/settings_input"
                            android:hint="@string/playlist_url_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textUri"
                            android:nextFocusUp="@id/tab_source"
                            android:nextFocusDown="@id/save_button"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textColorHint="#78909C"
                            android:textSize="@dimen/settings_control_text_size" />

                        <TextView
                            android:id="@+id/url_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:textColor="@color/red"
                            android:textSize="@dimen/settings_body_text_size"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_resolvers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_resolvers_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="@dimen/settings_card_padding">

                        <TextView
                            android:id="@+id/resolver_catalog_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/resolver_catalog_description"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />

                        <Button
                            android:id="@+id/update_resolvers_button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/settings_action_height"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/focus_button"
                            android:focusable="true"
                            android:includeFontPadding="false"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:nextFocusUp="@id/tab_resolvers"
                            android:nextFocusDown="@id/save_button"
                            android:text="@string/update_resolvers"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_action_text_size" />

                        <TextView
                            android:id="@+id/resolver_update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:text="@string/resolver_groups_title"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_card_title_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/resolver_groups_description"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/settings_body_text_size" />

                    <LinearLayout
                        android:id="@+id/resolver_groups_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_interface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_interface_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/interface_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:focusable="true"
                        android:nextFocusUp="@id/tab_interface"
                        android:nextFocusDown="@id/save_button"
                        android:padding="@dimen/settings_info_padding"
                        android:text="@string/settings_interface_description"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/settings_info_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_page_updates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_page_horizontal_padding"
                    android:paddingEnd="@dimen/settings_page_horizontal_padding"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_updates_heading"
                        android:textColor="@color/cyan"
                        android:textSize="@dimen/settings_heading_text_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/settings_section_margin_top"
                        android:background="@drawable/settings_section_card"
                        android:orientation="vertical"
                        android:padding="@dimen/settings_card_padding">

                        <TextView
                            android:id="@+id/current_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_card_title_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/settings_updates_description"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size" />

                        <Button
                            android:id="@+id/check_updates_button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/settings_action_height"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/focus_button"
                            android:focusable="true"
                            android:includeFontPadding="false"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:nextFocusUp="@id/tab_updates"
                            android:nextFocusDown="@id/save_button"
                            android:text="@string/check_updates"
                            android:textColor="@color/white"
                            android:textSize="@dimen/settings_action_text_size" />

                        <TextView
                            android:id="@+id/update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:textColor="@color/muted"
                            android:textSize="@dimen/settings_body_text_size"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_footer_height"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                android:layout_width="@dimen/settings_save_button_width"
                android:layout_height="@dimen/settings_footer_button_height"
                android:layout_marginEnd="8dp"
                android:background="@drawable/focus_button"
                android:focusable="true"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:nextFocusRight="@id/cancel_button"
                android:text="@string/save_and_play"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_footer_text_size" />

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="@dimen/settings_cancel_button_width"
                android:layout_height="@dimen/settings_footer_button_height"
                android:background="@drawable/focus_button"
                android:focusable="true"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:nextFocusLeft="@id/save_button"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/settings_footer_text_size" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
