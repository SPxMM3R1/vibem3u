<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso «Mejor calidad disponible»: no detiene el video ni lo atenúa. 0.5.98: flota a la
     derecha sobre una sombra desde el borde, como el selector (antes, abajo a la izquierda). Se cierra solo; si el cambio falla, la app vuelve a la anterior. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quality_upgrade_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/quality_toast_scrim" />

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="60dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/minimal_live_dot"
            android:gravity="center_vertical"
            android:text="@string/quality_upgrade_kicker"
            android:textAllCaps="true"
            android:textColor="#9EFFFFFF"
            android:textSize="7.5sp" />

        <TextView
            android:id="@+id/quality_upgrade_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.015"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quality_upgrade_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#BDFFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quality_upgrade_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="23dp"
                android:background="@drawable/scene_button"
                                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:stateListAnimator="@null"
                android:text="@string/quality_upgrade_switch"
                android:textAllCaps="false"
                android:textColor="@color/scene_button_text"
                android:textSize="11sp" />

            <Button
                android:id="@+id/quality_upgrade_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/scene_button"
                                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:stateListAnimator="@null"
                android:text="@string/quality_upgrade_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/scene_button_text"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/quality_upgrade_timer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="110dp"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:max="1000"
            android:progress="1000"
            android:progressBackgroundTint="#2EFFFFFF"
            android:progressTint="@color/cyan" />
    </LinearLayout>
</FrameLayout>
