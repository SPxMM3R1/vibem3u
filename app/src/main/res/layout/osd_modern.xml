<?xml version="1.0" encoding="utf-8"?>
<!-- OSD moderno (0.5.42+): se infla dentro de @id/channel_overlay. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <cl.streambox.tv.OsdScrimView
        android:id="@+id/osd_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/osd_hero"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/channel_overlay_horizontal_margin"
        android:layout_marginBottom="46dp"
        android:orientation="vertical">

        <!-- La fila crece si el logo tiene ajuste de tamaño (0.5.60). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/channel_logo_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginEnd="9dp">

                <ImageView
                    android:id="@+id/channel_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="Logo del canal"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/channel_logo_fallback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Solo para accesibilidad y respaldo: el logo reemplaza al nombre. -->
        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <cl.streambox.tv.ContinuousMarqueeTextView
            android:id="@+id/content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:text="@string/live_content"
            android:textColor="@color/white"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osd_description"
            android:layout_width="450dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="4"
            android:textColor="@color/osd_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/live_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/cyan"
                android:progressBackgroundTint="#24FFFFFF"
                android:progressTint="@color/cyan" />

            <TextView
                android:id="@+id/programme_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/osd_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/osd_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/osd_muted"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Número del canal: a la derecha, a media altura (2026-10-03). Va sobre el video,
         por eso lleva sombra para leerse en imágenes claras. -->
    <TextView
        android:id="@+id/channel_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/channel_overlay_horizontal_margin"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textColor="#C9D3D7"
        android:textSize="23sp" />

    <!-- Reloj y fecha dentro del OSD, sobre los datos técnicos. -->
    <LinearLayout
        android:id="@+id/osd_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/channel_overlay_horizontal_margin"
        android:layout_marginBottom="42dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/osd_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/osd_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/osd_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/osd_tech"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/channel_overlay_horizontal_margin"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/video_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="— · —"
            android:textColor="@color/osd_muted"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="  ·  "
            android:textColor="@color/osd_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/codec_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxWidth="360dp"
            android:maxLines="1"
            android:text="— · — · —"
            android:textColor="@color/osd_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/status_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:text="●"
            android:textColor="@color/amber"
            android:textSize="9sp" />

        <!-- El punto de color reemplaza al texto de estado (se conserva para lectores). -->
        <TextView
            android:id="@+id/stream_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
    <!-- Tamaño del logo en vivo (0.5.60): se ubica junto al logo desde MainActivity. -->
    <LinearLayout
        android:id="@+id/logo_size_adjust"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/logo_size_value"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/logo_size_pill"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#05080A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logo_size_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.3"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/logo_size_hint"
            android:textColor="#C9D3D7"
            android:textSize="11sp" />
    </LinearLayout>
</merge>
