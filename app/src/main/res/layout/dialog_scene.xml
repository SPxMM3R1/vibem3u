<?xml version="1.0" encoding="utf-8"?>
<!-- Escena genérica con dos acciones; MainActivity y Opciones ponen los textos.
     Estilo «escena» (2026-10-03): el video sigue vivo y atenuado, el degradado negro del OSD
     sube desde abajo y el contenido va abajo a la izquierda con los márgenes del OSD. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#61000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scene_scrim_start" />

    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scene_scrim" />

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="52dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/scene_kicker_line"
                android:layout_width="14dp"
                android:layout_height="1.5dp"
                android:layout_marginEnd="7dp"
                android:background="@color/cyan" />

            <TextView
            android:id="@+id/scene_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="@string/premium_kicker"
                android:textAllCaps="true"
                android:textColor="@color/osd_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
        android:id="@+id/scene_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/premium_kicker"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scene_message"
            android:layout_width="450dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#B7C4CA"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scene_primary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/scene_button"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="19dp"
                android:paddingEnd="19dp"
                android:stateListAnimator="@null"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/scene_button_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/scene_secondary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/scene_button"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="19dp"
                android:paddingEnd="19dp"
                android:stateListAnimator="@null"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/scene_button_text"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
