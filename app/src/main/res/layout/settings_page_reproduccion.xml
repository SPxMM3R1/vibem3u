<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones › playback (moderno). Se incluye desde activity_settings.xml (0.6.02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_page_playback"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/settings_current_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.2"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="#9EFFFFFF"
        android:textSize="7.5sp" />
    <TextView
        android:id="@+id/settings_current_programme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:letterSpacing="-0.015"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="23sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/settings_current_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/settings_no_current_channel"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:id="@+id/current_channel_playback_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/settings_quality_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/settings_quality_remembered"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/settings_quality_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
    <TextView
        android:id="@+id/settings_quality_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/settings_quality_no_options"
        android:textColor="@color/minimal_muted"
        android:textSize="8.5sp"
        android:visibility="gone" />
    <Switch
        android:thumb="@drawable/settings_switch_thumb"
        android:track="@drawable/settings_switch_track"
        android:switchMinWidth="26dp"
        android:id="@+id/settings_subtitles_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:focusable="true"
        android:minHeight="40dp"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp"
        android:showText="false"
        android:textColor="@color/settings_row_title"
        android:textSize="11.5sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/settings_subtitles_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:minHeight="40dp"
        android:paddingStart="0dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp"
        android:text="@string/subtitles_waiting_for_text"
        android:textColor="@color/white"
        android:textSize="11.5sp" />
    <!-- Audio (0.6.11, mockup aprobado): solo con más de una pista. -->
    <LinearLayout
        android:id="@+id/settings_audio_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/settings_audio_title"
            android:textColor="@color/settings_row_title"
            android:textSize="11.5sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_audio_detail"
            android:textColor="@color/settings_row_detail"
            android:textSize="8.5sp" />
        <LinearLayout
            android:id="@+id/settings_audio_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
    <!-- Sincronía del audio (0.6.31, mockup aprobado): OK vuelve al video y se ajusta en vivo. -->
    <LinearLayout
        android:id="@+id/settings_audio_sync_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/settings_audio_sync_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/settings_audio_sync_detail"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/settings_audio_sync_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:textColor="@color/settings_row_detail"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/open_source_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/settings_signal_source_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/settings_signal_source_description"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:text="@string/settings_signal_source_row_action"
            android:textColor="@color/settings_row_detail"
            android:textSize="9.5sp" />
    </LinearLayout>
    <!-- Tamaño del logo (0.5.60): OK vuelve al video y se ajusta en vivo. -->
    <LinearLayout
        android:id="@+id/logo_size_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="6dp"
        android:paddingEnd="0dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/logo_size_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:id="@+id/logo_size_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/logo_size_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:textColor="@color/settings_row_detail"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
