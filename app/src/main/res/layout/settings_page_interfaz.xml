<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones › interface (moderno). Se incluye desde activity_settings.xml (0.6.02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_page_interface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/settings_ui_style_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/settings_ui_style_description"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:padding="0dp">
            <TextView
                android:id="@+id/ui_style_modern"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:background="@drawable/segment_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_ui_style_modern"
                android:textColor="@color/segment_option_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/ui_style_classic"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:background="@drawable/segment_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_ui_style_classic"
                android:textColor="@color/segment_option_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/settings_channel_buttons_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/invert_channel_keys_description"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:padding="0dp">
            <TextView
                android:id="@+id/channel_keys_standard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:background="@drawable/segment_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_channel_buttons_standard"
                android:textColor="@color/segment_option_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/channel_keys_inverted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:background="@drawable/segment_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_channel_buttons_inverted"
                android:textColor="@color/segment_option_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <Switch
        android:thumb="@drawable/settings_switch_thumb"
        android:track="@drawable/settings_switch_track"
        android:switchMinWidth="26dp"
        android:id="@+id/invert_channel_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:focusable="true"
        android:minHeight="40dp"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp"
        android:showText="false"
        android:text="@string/invert_channel_keys"
        android:textColor="@color/settings_row_title"
        android:textSize="11.5sp"
        android:visibility="gone" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/settings_shortcuts_title"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_ok"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_ok_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_ok_twice"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_ok_twice_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_hold_ok"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_hold_ok_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_left"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_left_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_right"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_right_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_shortcut_up_down"
                    android:textColor="@color/minimal_muted"
                    android:textSize="8.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_shortcut_up_down_action"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
