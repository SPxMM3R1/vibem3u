<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/loading_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center">

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/loading_playlist"
            android:textColor="@color/white"
            android:paddingHorizontal="32dp"
            android:textSize="18sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="@dimen/channel_overlay_horizontal_margin"
        android:includeFontPadding="false"
        android:shadowColor="#A0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/osd_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <include layout="@layout/programme_detail_overlay" />

    <!-- OSD con el lenguaje de la Guía: pantalla completa, degradado abajo a la izquierda,
         logo con tamaño óptico, título grande, descripción, avance y «Después». Los datos
         técnicos van chicos abajo a la derecha. -->
    <FrameLayout
        android:id="@+id/channel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <cl.streambox.tv.OsdScrimView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/osd_hero"
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/channel_overlay_horizontal_margin"
            android:layout_marginBottom="46dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="9dp">

                    <ImageView
                        android:id="@+id/channel_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:contentDescription="Logo del canal"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/channel_logo_fallback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxWidth="220dp"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/channel_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/osd_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Solo para accesibilidad y respaldo: el logo reemplaza al nombre. -->
            <TextView
                android:id="@+id/channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <cl.streambox.tv.ContinuousMarqueeTextView
                android:id="@+id/content_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:text="@string/live_content"
                android:textColor="@color/white"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/osd_description"
                android:layout_width="450dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="2"
                android:textColor="@color/osd_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/live_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="200dp"
                    android:layout_height="3dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/cyan"
                    android:progressBackgroundTint="#24FFFFFF"
                    android:progressTint="@color/cyan" />

                <TextView
                    android:id="@+id/programme_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/osd_muted"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/osd_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/osd_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/channel_overlay_horizontal_margin"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/video_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="— · —"
                android:textColor="@color/osd_muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="  ·  "
                android:textColor="@color/osd_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/codec_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxWidth="360dp"
                android:maxLines="1"
                android:text="— · — · —"
                android:textColor="@color/osd_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:text="●"
                android:textColor="@color/amber"
                android:textSize="9sp" />

            <!-- El punto de color reemplaza al texto de estado (se conserva para lectores). -->
            <TextView
                android:id="@+id/stream_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- Guía completa (D-pad izquierda): pantalla completa; dibuja su propio fondo y deja
         asomar el video a la derecha del hero. -->
    <cl.streambox.tv.EpgGuideView
        android:id="@+id/guide_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone" />

    <include layout="@layout/source_selector_overlay" />

</FrameLayout>
