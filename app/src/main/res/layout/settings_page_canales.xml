<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones › source (moderno). Se incluye desde activity_settings.xml (0.6.02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_page_source"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/settings_section_lists"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <!-- Lista principal (0.6.13): dirección completa e interruptor; el ancho de la fila se alinea en código
         con el borde derecho de la pestaña «Sistema». Apagada conserva la dirección. -->
    <LinearLayout
        android:id="@+id/playlist_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/playlist_1_label"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_primary_list_title"
            android:textColor="@color/white"
            android:textSize="11.5sp" />
        <EditText
            android:id="@+id/playlist_url"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/settings_input"
            android:hint="@string/playlist_url_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#78909C"
            android:textSize="8.5sp" />
        <Switch
            android:id="@+id/playlist_enabled_1"
            android:layout_width="88dp"
            android:layout_height="26dp"
            android:layout_marginStart="14dp"
            android:background="@null"
            android:focusable="true"
            android:minHeight="0dp"
            android:nextFocusDown="@+id/playlist_enabled_2"
            android:showText="false"
            android:switchMinWidth="26dp"
            android:switchPadding="8dp"
            android:text="@string/settings_list_switch_on"
            android:textColor="@color/minimal_button_text"
            android:textSize="10sp"
            android:thumb="@drawable/minimal_switch_thumb"
            android:track="@drawable/minimal_switch_track" />
    </LinearLayout>
    <!-- Lista secundaria (0.6.13): dirección completa e interruptor; el ancho de la fila se alinea en código
         con el borde derecho de la pestaña «Sistema». Apagada conserva la dirección. -->
    <LinearLayout
        android:id="@+id/playlist_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/playlist_2_label"
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:text="@string/settings_secondary_list_title"
            android:textColor="@color/white"
            android:textSize="11.5sp" />
        <EditText
            android:id="@+id/playlist_url_2"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/settings_input"
            android:hint="@string/settings_secondary_list_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#78909C"
            android:textSize="8.5sp" />
        <Switch
            android:id="@+id/playlist_enabled_2"
            android:layout_width="88dp"
            android:layout_height="26dp"
            android:layout_marginStart="14dp"
            android:background="@null"
            android:focusable="true"
            android:minHeight="0dp"
            android:nextFocusDown="@+id/save_button"
            android:showText="false"
            android:switchMinWidth="26dp"
            android:switchPadding="8dp"
            android:text="@string/settings_list_switch_on"
            android:textColor="@color/minimal_button_text"
            android:textSize="10sp"
            android:thumb="@drawable/minimal_switch_thumb"
            android:track="@drawable/minimal_switch_track" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:stateListAnimator="@null"
            android:text="@string/save_and_play"
            android:textAllCaps="false"
            android:textColor="@color/minimal_button_text"
            android:textSize="10.5sp" />
        <Button
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="22dp"
            android:background="@drawable/focus_button"
            android:focusable="true"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:stateListAnimator="@null"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/minimal_button_text"
            android:textSize="10.5sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/url_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/red"
        android:textSize="8.5sp"
        android:visibility="gone" />
    <!-- Canales de adultos (0.6.36, mockup aprobado): fila Desbloquear/Bloquear; la llena SettingsActivity. -->
    <TextView
        android:id="@+id/adult_channels_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.2"
        android:singleLine="true"
        android:text="@string/adult_channels_section"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:id="@+id/adult_channels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <!-- Ocultos en esta TV (0.5.90): solo aparece si hay alguno. -->
    <TextView
        android:id="@+id/hidden_channels_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:text="@string/hidden_channels_title"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/hidden_channels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
