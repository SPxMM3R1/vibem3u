<?xml version="1.0" encoding="utf-8"?>
<!-- Vincular Highfly Premium con el teléfono (QR y código de 4 dígitos).
     Estilo «escena» (2026-10-03): el video sigue vivo y atenuado, el degradado negro del OSD
     sube desde abajo y el contenido va abajo a la izquierda con los márgenes del OSD. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scene_scrim_start" />

    <View
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scene_scrim" />

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:text="@string/premium_kicker"
            android:textAllCaps="true"
            android:textColor="#9EFFFFFF"
            android:textSize="7.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.015"
            android:text="@string/premium_pair_title"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/premium_pair_message"
            android:textColor="#BDFFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/premium_pair_digit_0"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/scene_code_cell"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:letterSpacing="0.16" />

            <TextView
                android:id="@+id/premium_pair_digit_1"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/scene_code_cell"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:letterSpacing="0.16" />

            <TextView
                android:id="@+id/premium_pair_digit_2"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/scene_code_cell"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:letterSpacing="0.16" />

            <TextView
                android:id="@+id/premium_pair_digit_3"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/scene_code_cell"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:letterSpacing="0.16" />

        </LinearLayout>

        <TextView
            android:id="@+id/premium_pair_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:includeFontPadding="false"
            android:drawablePadding="7dp"
            android:drawableStart="@drawable/scene_status_dot"
            android:gravity="center_vertical"
            android:textColor="#9EFFFFFF"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/premium_pair_cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/scene_button"
                                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="7dp"
                android:stateListAnimator="@null"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/scene_button_text"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/premium_pair_qr"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/scene_qr_background"
            android:contentDescription="@string/premium_pair_qr_description"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/premium_pair_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:textColor="@color/osd_muted"
            android:textSize="9.5sp" />
    </LinearLayout>
</FrameLayout>
