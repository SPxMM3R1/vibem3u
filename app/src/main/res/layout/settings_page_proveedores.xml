<?xml version="1.0" encoding="utf-8"?>
<!-- Opciones › providers (moderno). Se incluye desde activity_settings.xml (0.6.02). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_page_providers"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/resolver_groups_title"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:id="@+id/resolver_groups_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/settings_provider_selection_web"
        android:textColor="@color/minimal_muted"
        android:textSize="8.5sp" />
    <!-- Highfly Premium (2026-10-03): se vincula con el teléfono (QR). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/premium_kicker"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:id="@+id/premium_account_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/premium_account_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/premium_link_title"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:id="@+id/premium_account_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/premium_link_description"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/premium_account_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:text="@string/premium_link_action"
            android:textColor="@color/settings_row_detail"
            android:textSize="9.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/premium_region_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/premium_region_title"
            android:textColor="@color/white"
            android:textSize="11.5sp" />
        <LinearLayout
            android:id="@+id/premium_region_options"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:padding="0dp" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/settings_section_advanced"
        android:textAllCaps="true"
        android:textColor="#6BFFFFFF"
        android:textSize="7sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp">
        <TextView
            android:layout_width="108dp"
            android:layout_height="wrap_content"
            android:text="@string/highfly_manifest_title"
            android:textColor="@color/white"
            android:textSize="11.5sp" />
        <EditText
            android:id="@+id/highfly_manifest_url"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:background="@drawable/settings_input"
            android:hint="@string/highfly_manifest_url_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#78909C"
            android:textSize="8.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/mediaflow_settings_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/settings_section_card"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:includeFontPadding="false"
                android:text="@string/mediaflow_open_settings"
                android:textColor="@color/settings_row_title"
                android:textSize="11.5sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:duplicateParentState="true"
                android:text="@string/settings_mediaflow_description"
                android:textColor="@color/settings_row_detail"
                android:textSize="8.5sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:duplicateParentState="true"
            android:text="@string/settings_mediaflow_action"
            android:textColor="@color/settings_row_detail"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
