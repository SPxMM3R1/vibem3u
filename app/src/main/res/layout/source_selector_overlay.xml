<?xml version="1.0" encoding="utf-8"?>
<!-- Fuentes y calidades. Moderno (0.5.95, minimalista): texto flotante a la derecha sobre un
     difuminado horizontal (source_selector_shade, se pinta en applyMinimalSelectorShade), sin
     paneles ni bordes. Los degradados antiguos quedan ocultos. El clásico reacomoda este mismo
     layout en un panel centrado (applyClassicChrome), con los mismos IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/source_selector_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone">

    <View
        android:id="@+id/source_selector_dim"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#61000000" />

    <View
        android:id="@+id/source_selector_scrim_start"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scene_scrim_start" />

    <View
        android:id="@+id/source_selector_scrim"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scene_scrim" />

    <View
        android:id="@+id/source_selector_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/source_selector_panel"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="64dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/source_selector_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/source_selector_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/source_selector_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/source_selector_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="9dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <ScrollView
                android:id="@+id/source_selector_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadingEdge="none"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/source_selector_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <View
                android:id="@+id/source_selector_more_fade"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_gravity="bottom"
                android:background="@drawable/source_selector_more_fade"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/source_selector_more_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="@string/source_selector_more_hint"
            android:textColor="@color/osd_muted"
            android:textSize="9.5sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/source_selector_close"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/scene_button"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:nextFocusUp="@id/source_selector_options"
            android:paddingStart="19dp"
            android:paddingEnd="19dp"
            android:stateListAnimator="@null"
            android:text="@string/source_selector_close"
            android:textAllCaps="false"
            android:textColor="@color/scene_button_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
