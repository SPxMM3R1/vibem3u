<?xml version="1.0" encoding="utf-8"?>
<!-- Fuentes y calidades (2026-10-03, estilo «escena»): pantalla completa sobre el video
     atenuado, degradado del OSD y lista abajo a la izquierda. El clásico reacomoda este mismo
     layout en un panel centrado (applyClassicChrome), con los mismos IDs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/source_selector_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone">

    <View
        android:id="@+id/source_selector_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#61000000" />

    <View
        android:id="@+id/source_selector_scrim_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scene_scrim_start" />

    <View
        android:id="@+id/source_selector_scrim"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scene_scrim" />

    <LinearLayout
        android:id="@+id/source_selector_panel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/source_selector_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/osd_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/source_selector_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/source_selector_title"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/source_selector_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#B7C4CA"
            android:textSize="12.5sp" />

        <ScrollView
            android:id="@+id/source_selector_scroll"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginTop="14dp"
            android:fadingEdge="none"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/source_selector_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/source_selector_close"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/scene_button"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:nextFocusUp="@id/source_selector_options"
            android:paddingStart="19dp"
            android:paddingEnd="19dp"
            android:stateListAnimator="@null"
            android:text="@string/source_selector_close"
            android:textAllCaps="false"
            android:textColor="@color/scene_button_text"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
