<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de recordatorio (0.5.98, «Flotante minimalista»): texto en la esquina superior derecha
     sobre una sombra suave que nace de la esquina, sin panel. «Ver» es una acción de texto. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reminder_background">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminder_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/reminder_ring"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#9EFFFFFF"
            android:textSize="7.5sp" />

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="-0.015"
            android:maxLines="1"
            android:shadowColor="#73000000"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/reminder_watch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/scene_button"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingBottom="7dp"
            android:paddingTop="4dp"
            android:stateListAnimator="@null"
            android:text="@string/reminder_watch_now"
            android:textAllCaps="false"
            android:textColor="@color/scene_button_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
