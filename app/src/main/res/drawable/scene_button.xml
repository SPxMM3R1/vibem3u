<?xml version="1.0" encoding="utf-8"?>
<!-- Acción de las escenas (0.5.98, «Flotante minimalista», DISENO.md): texto; con foco, una
     línea blanca fina debajo (la negrita la pone SceneDialog). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1.5dp">
                <shape><solid android:color="@color/white" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
