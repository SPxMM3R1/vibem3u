<?xml version="1.0" encoding="utf-8"?>
<!-- Píldora de los diálogos «escena»: con foco, blanco sólido con halo; si no, vidrio tenue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2EFFFFFF" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <inset android:insetBottom="2dp" android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#0DFFFFFF" />
                <corners android:radius="999dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetBottom="2dp" android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#1AFFFFFF" />
                <corners android:radius="999dp" />
            </shape>
        </inset>
    </item>
</selector>
