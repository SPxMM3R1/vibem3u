<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de Opciones (0.5.96, «Flotante minimalista»): una sola capa que oscurece desde la
     izquierda, donde va la columna, y apenas arriba; el video asoma a la derecha. 0.6.33: la
     zona oscura llega un poco más a la derecha para la columna «Información de la señal». -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- 0.6.39 (mockup aprobado «Si»): velo parejo en toda la pantalla; con dos
                 columnas (Información de la señal, Proveedores) la derecha ya no queda sobre el video. -->
            <solid android:color="#E0000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80000000" android:centerColor="#00000000"
                android:centerY="0.2" android:endColor="#00000000" android:type="linear" />
        </shape>
    </item>
</layer-list>
