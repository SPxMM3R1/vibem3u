<?xml version="1.0" encoding="utf-8"?>
<!-- Opción elegible de Opciones (calidades, Moderno|Clásico…, 0.5.96): texto; la elegida
     lleva el punto verde a la derecha y el foco una línea fina debajo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1.5dp">
                <shape><solid android:color="@color/white" /></shape>
            </item>
            <item android:gravity="end|center_vertical" android:width="4dp" android:height="4dp">
                <shape android:shape="oval"><solid android:color="#5BE9A0" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="end|center_vertical" android:width="4dp" android:height="4dp">
                <shape android:shape="oval"><solid android:color="#5BE9A0" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1.5dp">
                <shape><solid android:color="@color/white" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
