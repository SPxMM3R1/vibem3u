<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF182429" />
            <stroke android:width="2dp" android:color="@color/cyan" />
            <corners android:radius="8dp" />
            <padding android:left="16dp" android:top="0dp" android:right="16dp" android:bottom="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF182429" />
            <stroke android:width="1dp" android:color="#607D8B" />
            <corners android:radius="8dp" />
            <padding android:left="16dp" android:top="0dp" android:right="16dp" android:bottom="0dp" />
        </shape>
    </item>
</selector>
