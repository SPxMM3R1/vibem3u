<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de Opciones (0.5.96): sin caja, solo una línea tenue debajo; blanca con foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1.5dp">
                <shape><solid android:color="@color/white" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1dp">
                <shape><solid android:color="#33FFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
